generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StageStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum ProjectType {
  SOFTWARE
}

model Project {
  id            String        @id @default(uuid())
  title         String
  description   String?
  businessLogic String?  @db.Text
  status        ProjectStatus @default(PLANNING)
  type          ProjectType   @default(SOFTWARE)
  githubRepo    String?
  settings      Json?
  order         Int           @default(0)
  isFavorite    Boolean       @default(false)
  color         String?
  icon          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  updateLogs  UpdateLog[]
  members     Member[]
  kanbans     Kanban[]
  notes       Note[]
  links       ProjectLink[]
  whiteboards Whiteboard[]
  checklists  Checklist[]
  bookmarks   Bookmark[]
}

model Kanban {
  id        String         @id @default(uuid())
  title     String
  projectId String
  order     Int            @default(0)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   KanbanColumn[]
  tags      KanbanTag[]
  tasks     Task[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model KanbanColumn {
  id        String   @id @default(uuid())
  title     String
  order     Int      @default(0)
  kanbanId  String
  kanban    Kanban   @relation(fields: [kanbanId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KanbanTag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#3b82f6")
  kanbanId  String
  kanban    Kanban   @relation(fields: [kanbanId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  projectId String
  order     Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UpdateLog {
  id        String   @id @default(uuid())
  title     String
  content       String   @db.Text
  author    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id        String   @id @default(uuid())
  name      String
  role      String
  email     String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      String        @default("TODO")
  columnId    String?
  column      KanbanColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  tags        KanbanTag[]
  dueDate     DateTime?
  kanbanId    String
  kanban      Kanban        @relation(fields: [kanbanId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Subtask {
  id        String   @id @default(uuid())
  title     String
  isDone    Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id             String    @id @default(uuid())
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  locationOrLink String?
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ChatConversation {
  id        String        @id @default(uuid())
  title     String        @default("Nova conversa")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id             String           @id @default(uuid())
  role           String           // "user" | "assistant"
  content        String           @db.Text
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
}

model ProjectLink {
  id        String   @id @default(uuid())
  title     String
  url       String
  icon      String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// NEW: Whiteboard (freeform visual canvas)
// ============================================================
model Whiteboard {
  id        String   @id @default(uuid())
  title     String
  data      Json     @default("{}")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// NEW: Checklist (standalone checklists)
// ============================================================
model Checklist {
  id        String          @id @default(uuid())
  title     String
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ChecklistItem {
  id          String    @id @default(uuid())
  text        String
  isDone      Boolean   @default(false)
  order       Int       @default(0)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================
// NEW: Bookmark (link collection per project)
// ============================================================
model Bookmark {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?
  group       String?
  icon        String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
